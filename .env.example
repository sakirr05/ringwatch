# LLM providers for the narrative layer only.
# These are NEVER required to compute a fraud score, a flag, or any metric —
# the deterministic pipeline runs fully offline without them.
GEMINI_API_KEY=
GROQ_API_KEY=

# Razorpay webhook receiver. TEST MODE ONLY (rzp_test_... account).
# Set this to the secret you enter when creating the webhook in the Razorpay
# dashboard. Never commit a live-mode secret.
RAZORPAY_WEBHOOK_SECRET=

# Where the webhook event log lives. On free-tier hosting the disk is ephemeral,
# so this database does not survive a restart. No reported metric depends on it.
RINGWATCH_DB=data/webhook_events.db
