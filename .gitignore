# Secrets
.env

# Data: raw downloads and derived caches are reproducible, never committed
data/raw/
data/cache/
data/out/

# Webhook event log: ephemeral, per-instance, never committed
data/*.db

# NOTE: artifacts/ IS committed. It holds model_baseline.txt (6.8 MB), which the
# deployed demo needs for its clearly-labelled out-of-distribution scoring track,
# since data/cache/ is ignored.

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/
